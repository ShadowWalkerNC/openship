{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", ".wasp/out/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:saas": {
      "cache": false,
      "persistent": true
    },
    "dev:local-saas": {
      "cache": false,
      "persistent": true
    },
    "dev:saas-app": {
      "cache": false,
      "persistent": true
    },
    "dev:saas-blog": {
      "cache": false,
      "persistent": true
    },
    "build:saas-app": {
      "dependsOn": ["^build"],
      "outputs": [".wasp/out/**", ".wasp/build/**"]
    },
    "build:saas-blog": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {},
    "clean": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    }
  }
}
